{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Still",
  "version": "0.3.0",
  "identifier": "dev.still.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Still",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 500,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Still",
    "category": "DeveloperTool",
    "shortDescription": "A calm, keyboard-centric code editor",
    "longDescription": "Still is a keyboard-centric desktop code editor for Python, Java and more, with an integrated terminal, Git, packages and SSH.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
